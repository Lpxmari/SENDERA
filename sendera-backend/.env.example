# Copia este archivo como .env (ignorado por Git) y define los valores reales en tu entorno.
# Nunca subas secretos al repositorio.

# Base de datos MySQL (obligatorio)
DB_USER=root
DB_PORT=3306
DB_PASSWORD=cambiar

# Clave HS256 del JWT: obligatoria, mínimo 32 caracteres. En perfil "dev" existe un valor local por defecto.
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
JWT_EXPIRACION_HORAS=24

# Origen(es) permitidos por CORS, separados por comas. Sin comodines.
CORS_ORIGINS=http://localhost:5173

# Enlace del frontend usado en el correo de recuperación
FRONTEND_URL=http://localhost:5173

# Perfil de desarrollo local: imprime en consola el enlace de recuperación de contraseña (no usar en producción).
spring.profiles.active=dev

# Correo (opcional). Descomenta y completa SPRING_MAIL_HOST para enviar correos reales (no lo dejes vacío);
# solo con el perfil "dev" el enlace de recuperación se imprime en consola.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_REMITENTE=no-reply@sendera.com
