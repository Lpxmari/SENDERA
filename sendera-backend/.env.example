# Variables requeridas para la conexion local a MySQL.
# Define estos valores en el entorno; no guardes contrasenas reales en este archivo.
DB_USER=
DB_PASSWORD=

# --- Autenticacion ---
# Clave para firmar los JWT (minimo 32 caracteres). Obligatoria en produccion.
# JWT_SECRET=
JWT_EXPIRACION_HORAS=24
# URL del frontend, usada para armar el enlace del correo de recuperacion.
FRONTEND_URL=http://localhost:5173

# --- Correo (recuperacion de contrasena) ---
# Descomenta y completa SPRING_MAIL_HOST para enviar correos reales; mientras no exista (ni vacio), el enlace se imprime en la consola del backend.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_REMITENTE=no-reply@sendera.com
