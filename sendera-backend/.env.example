# Copia este archivo como .env (ignorado por Git) y define los valores reales en tu entorno.
# Nunca subas secretos al repositorio.

# Base de datos MySQL (obligatorio)
DB_USER=root
DB_PORT=3306
DB_PASSWORD=cambiar

# Clave HS256 del JWT: obligatoria en todos los perfiles (incluido "dev"), mínimo 32 caracteres, sin valor por defecto.
# Genera una propia siguiendo el README ("Configuración local") y no la compartas ni la subas a Git.
JWT_SECRET=
JWT_EXPIRACION_HORAS=24

# Origen(es) permitidos por CORS, separados por comas. Sin comodines.
CORS_ORIGINS=http://localhost:5173

# Enlace del frontend usado en la recuperación de contraseña.
FRONTEND_URL=http://localhost:5173

# --- Pagos con Mercado Pago (Checkout Pro). Opcional: sin token la app arranca y el pago en línea responde 503 ---
# Access Token de PRUEBA de tu aplicación (Tus integraciones > tu app > Pruebas > Credenciales de prueba).
# Suele empezar por APP_USR-. Es secreto: solo en el backend, nunca en el frontend ni en Git.
# MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks > Configurar notificaciones. Si se define, el webhook exige la firma x-signature.
# MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: URL HTTPS pública del webhook enviada en cada preferencia (normalmente se deja vacía).
# MERCADOPAGO_NOTIFICATION_URL=https://tu-backend.up.railway.app/api/v1/pagos/webhook

# Perfil de desarrollo local.
spring.profiles.active=dev

# --- Correo, opción A: Gmail en local (requiere verificación en 2 pasos y contraseña de aplicación) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-cuenta@gmail.com
# MAIL_PASSWORD=contrasena-de-aplicacion-de-16-letras-sin-espacios
# MAIL_REMITENTE=tu-cuenta@gmail.com
# MAIL_NOMBRE_REMITENTE=Sendera

# --- Correo, opción B: Brevo para el despliegue (si se define, tiene prioridad sobre SMTP) ---
# BREVO_API_KEY=
# MAIL_REMITENTE=remitente-verificado-en-brevo@dominio.com
# RECUPERACION_EXPIRACION_MINUTOS=15

# --- Límite de intentos de inicio de sesión (POST /auth/login) ---
# Intentos por minuto por la combinación IP + correo.
LOGIN_INTENTOS_POR_MINUTO=5
# Tope de intentos por minuto por IP (evita esquivar el límite cambiando de correo).
LOGIN_INTENTOS_POR_IP_POR_MINUTO=20
