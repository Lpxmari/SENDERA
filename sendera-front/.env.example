# Copia este archivo como .env.local (ignorado por Git). No guardes secretos: todo lo que empieza con VITE_
# queda visible en el navegador.

# URL base de la API. Opcional.
# En desarrollo no hace falta: Vite reenvía /api al backend en http://localhost:8080 (ver vite.config.js).
# En producción define la URL completa del backend, por ejemplo https://api.tu-dominio.com/api/v1
# VITE_API_URL=/api/v1
